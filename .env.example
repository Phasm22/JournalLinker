# journalLinker does NOT use repo-root .env in production.
#
# Install runtime config:
#   install -d -m 700 ~/.config/journal-linker
#   cp systemd/journal-linker.env.example ~/.config/journal-linker/journal-linker.env
#   chmod 600 ~/.config/journal-linker/journal-linker.env
#   ${EDITOR:-nano} ~/.config/journal-linker/journal-linker.env
#
# systemd units load: EnvironmentFile=-%h/.config/journal-linker/journal-linker.env
#
# Full variable list: see systemd/journal-linker.env.example
