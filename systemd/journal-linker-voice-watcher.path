# Fires when VoiceDrop changes (journal-linker-voice-ingest.service writes here). Directory must exist before: systemctl --user enable --now …
# Path must be literal (no env) and match SCRIBE_VOICEDROP_DIR. Default: ~/VoiceDrop — override with:
#   systemctl --user edit journal-linker-voice-watcher.path
[Unit]
Description=Journal Linker — watch VoiceDrop directory

[Path]
PathChanged=%h/VoiceDrop
Unit=journal-linker-voice-watcher.service

[Install]
WantedBy=paths.target
